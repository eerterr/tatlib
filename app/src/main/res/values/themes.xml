<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- UI целиком в Compose (ui/theme). XML-тема нужна манифесту и окну до первого кадра:
         фон окна = background из MASTER.md § 2 (cream), чтобы не мигало белым. -->
    <style name="Theme.Tatlib" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowBackground">@color/window_background</item>
    </style>
</resources>
