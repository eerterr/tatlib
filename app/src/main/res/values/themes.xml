<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Base application theme. UI itself is fully driven by Jetpack Compose (see ui/theme),
         this XML theme only needs to exist for the manifest / pre-Compose window background. -->
    <style name="Theme.Tatlib" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:windowBackground">@android:color/white</item>
    </style>
</resources>
